# ========================================
# ChatGon - Coolify Environment Variables
# ========================================
# Este archivo contiene todas las variables necesarias para el despliegue en Coolify
# Copia estas variables a la sección "Environment Variables" en Coolify

# ========================================
# OBLIGATORIAS - SEGURIDAD
# ========================================

# SECRET_KEY_BASE (generar con: bundle exec rake secret)
# IMPORTANTE: Debe ser una cadena alfanumérica larga y única
SECRET_KEY_BASE=CAMBIAR_POR_SECRET_KEY_GENERADA

# ========================================
# OBLIGATORIAS - APLICACIÓN
# ========================================

# URL principal de tu instalación ChatGon
FRONTEND_URL=https://chat.monexgon.app

# ========================================
# OBLIGATORIAS - BASE DE DATOS
# ========================================

# Configuración de PostgreSQL
POSTGRES_DATABASE=chatgon_production
POSTGRES_USERNAME=chatgon_user
POSTGRES_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURA

# DATABASE_URL (Coolify puede generar esto automáticamente)
# Si usas servicios de Coolify, esta variable se genera automáticamente
# De lo contrario, usa este formato:
# DATABASE_URL=postgresql://chatgon_user:PASSWORD@postgres:5432/chatgon_production

# ========================================
# OBLIGATORIAS - REDIS
# ========================================

REDIS_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURA

# ========================================
# BRAND - ChatGon
# ========================================

INSTALLATION_NAME=ChatGon
BRAND_NAME=ChatGon
BRAND_URL=https://chat.monexgon.app
WIDGET_BRAND_URL=https://chat.monexgon.app
BRAND_COLOR=#2781F6
LOGO=/brand-assets/logo-cg.svg
LOGO_DARK=/brand-assets/logo-dark.svg
LOGO_THUMBNAIL=/brand-assets/logo-thumbnail.svg
DISPLAY_MANIFEST=false

# ========================================
# SEGURIDAD - Sistema Privado
# ========================================

# Desactivar registro público de usuarios
ENABLE_ACCOUNT_SIGNUP=false

# Desactivar creación de cuentas/agentes desde dashboard
CREATE_NEW_ACCOUNT_FROM_DASHBOARD=false
CREATE_NEW_AGENT_FROM_DASHBOARD=false
DELETE_AGENT_FROM_DASHBOARD=false

# ========================================
# CONFIGURACIÓN INDEPENDIENTE
# ========================================

# Desactivar telemetría a servidores de Chatwoot
DISABLE_TELEMETRY=true

# Configurar como instalación auto-hospedada
DEPLOYMENT_ENV=self-hosted

# Plan Enterprise (desbloquea todas las características)
INSTALLATION_PRICING_PLAN=enterprise

# ========================================
# EMAIL (Recomendado)
# ========================================

MAILER_SENDER_EMAIL=ChatGon <admin@monexgon.app>
SMTP_DOMAIN=monexgon.app
SMTP_ADDRESS=smtp.hostinger.com
SMTP_PORT=587
SMTP_USERNAME=admin@monexgon.app
SMTP_PASSWORD=CAMBIAR_POR_PASSWORD_SMTP
SMTP_AUTHENTICATION=login
SMTP_ENABLE_STARTTLS_AUTO=true
SMTP_OPENSSL_VERIFY_MODE=peer

# Configuración de correo entrante
MAILER_INBOUND_EMAIL_DOMAIN=chat.monexgon.app
RAILS_INBOUND_EMAIL_SERVICE=relay
RAILS_INBOUND_EMAIL_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURA

# ========================================
# CONFIGURACIÓN GENERAL
# ========================================

# Idioma por defecto (español)
DEFAULT_LOCALE=es

# SSL (Coolify maneja SSL automáticamente con Traefik)
FORCE_SSL=false

# Almacenamiento local (no se usa S3)
ACTIVE_STORAGE_SERVICE=local

# ========================================
# RENDIMIENTO
# ========================================

RAILS_MAX_THREADS=5
SIDEKIQ_CONCURRENCY=10

# ========================================
# MOBILE APP (Opcional)
# ========================================

IOS_APP_ID=L7YLMN4634.com.chatgon.app
ANDROID_BUNDLE_ID=com.chatgon.app
ANDROID_SHA256_CERT_FINGERPRINT=AC:73:8E:DE:EB:56:EA:CC:10:87:02:A7:65:37:7B:38:D4:5D:D4:53:F8:3B:FB:D3:C6:28:64:1D:AA:08:1E:D8
ENABLE_PUSH_RELAY_SERVER=true

# ========================================
# AVANZADO (Opcional)
# ========================================

# Logs
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info

# API
API_RATE_LIMIT=1000
API_ACCESS_TOKEN_EXPIRY=24

# ========================================
# INSTRUCCIONES DE USO EN COOLIFY
# ========================================
#
# 1. En Coolify, ve a tu proyecto > Environment Variables
# 2. Agrega cada variable usando el formato: NOMBRE=valor
# 3. Variables OBLIGATORIAS que debes cambiar:
#    - SECRET_KEY_BASE (generar nuevo)
#    - POSTGRES_PASSWORD (generar nuevo)
#    - REDIS_PASSWORD (generar nuevo)
#    - SMTP_PASSWORD (si usas email)
#    - RAILS_INBOUND_EMAIL_PASSWORD (generar nuevo)
#
# 4. Para generar contraseñas seguras:
#    openssl rand -base64 32
#
# 5. Para generar SECRET_KEY_BASE (ejecutar localmente):
#    docker run --rm -it chatwoot:latest bundle exec rake secret
#    O si tienes Ruby instalado:
#    bundle exec rake secret
#
# 6. Después de configurar todas las variables, haz clic en "Deploy"
#
# ========================================
